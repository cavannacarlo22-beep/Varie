# Connessione al database Neon (creata in automatico dall'integrazione Neon su Vercel)
DATABASE_URL="postgresql://utente:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Password per entrare nel pannello /admin
ADMIN_PASSWORD="scegli-una-password-lunga"

# Token di Vercel Blob per caricare le foto (creato in automatico collegando uno store Blob al progetto)
BLOB_READ_WRITE_TOKEN=""

# Indirizzo pubblico del sito (per sitemap e anteprime social)
NEXT_PUBLIC_SITE_URL="https://www.autovillella.it"
