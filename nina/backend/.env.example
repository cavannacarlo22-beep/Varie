# FILE: backend/.env.example
#
# Copia questo file in `.env` e riempi i valori. Il file `.env` NON va mai
# messo in git: è già escluso dal .gitignore.
#
# Per generare un segreto sicuro:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# --- Database Neon -----------------------------------------------------------
# La stringa che copi da Neon → Dashboard → Connection Details.
# Deve finire con ?sslmode=require. Usa la stringa "pooled" per la produzione.
DATABASE_URL=postgresql://utente:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/nina?sslmode=require

# --- Sicurezza ---------------------------------------------------------------
# Due segreti DIVERSI. Non riutilizzare lo stesso valore.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Durata dell'access token. Breve di proposito.
ACCESS_TOKEN_TTL=15m
# Durata del refresh token.
REFRESH_TOKEN_TTL_DAYS=60

# --- Server ------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Origini autorizzate a chiamare l'API da browser, separate da virgola.
# L'app iOS non è un browser e non è soggetta a CORS: questo serve solo se
# aggiungi in futuro una pagina web (per esempio il reset password).
CORS_ORIGINS=http://localhost:5173

# URL pubblico del backend, usato nei link di verifica email e reset password.
PUBLIC_BASE_URL=http://localhost:3000

# --- Email -------------------------------------------------------------------
# Se SMTP_HOST è vuoto, le email non vengono spedite ma stampate nei log:
# comodo in sviluppo, da configurare prima di andare in produzione.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Nina <ciao@tuodominio.it>"

# --- AI ----------------------------------------------------------------------
# Schermata "La mia amica".
#
# Lascia "none" e non paghi niente: risponde il motore conversazionale
# incluso nel backend (src/services/ninaBrain.ts), che riconosce decine di
# argomenti e non richiede nessun servizio esterno. È la modalità predefinita.
#
# Metti "anthropic" con una chiave se vuoi risposte generate da un modello
# linguistico: sono più libere, ma ogni messaggio ha un costo a tuo carico.
# Anche in quel caso, se il modello non risponde interviene il motore locale.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-opus-5
# Limite di messaggi AI per utente al giorno, per tenere sotto controllo i costi.
AI_DAILY_MESSAGE_LIMIT=40
